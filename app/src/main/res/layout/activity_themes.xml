<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DSX Keyboard Themes"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Active Theme Preview"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <!-- High contrast interactive preview card -->
        <LinearLayout
            android:id="@+id/previewContainer"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="#1E1E1E"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/previewText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DSX Keyboard Theme"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
            
            <TextView
                android:id="@+id/previewSubtext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sample Layout: [ Q W E R T Y ]"
                android:textColor="#1E88E5"
                android:textSize="14sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Theme Selection Buttons -->
        <Button
            android:id="@+id/btnThemeDark"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Dark Modern (Default)"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2D2D2D"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnThemeBlue"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="DSX Neon Blue"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0088FF"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnThemeAMOLED"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Pitch Black AMOLED"
            android:textColor="#FFFFFF"
            android:backgroundTint="#000000"
            android:layout_marginBottom="12dp" />

    </LinearLayout>
</ScrollView>
